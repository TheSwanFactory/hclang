{
  "name": "@swanfactory/hcweb",
  "version": "0.9.2",
  "description": "Homoiconic C - Web Components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheSwanFactory/hclang.git",
    "directory": "web"
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "test": "deno test -A tests/*.test.tsx && deno task test:consumer",
    "test:consumer": "deno task --config tests/consumer/deno.json --lock ../deno.lock build",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "exports": {
    ".": "./mod.ts",
    "./islands/Main": "./islands/Main.tsx",
    "./styles": "./styles.ts"
  },
  "publish": {
    "exclude": [
      "assets/",
      "CLAUDE.md",
      "client.ts",
      "main.ts",
      "routes/",
      "static/",
      "tests/",
      "utils.ts",
      "vite.config.ts"
    ]
  },
  "exclude": ["**/_fresh/*", "tests/consumer/_fresh/"],
  "imports": {
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@1.1.2",
    "@preact/signals": "npm:@preact/signals@2.11.0",
    "@testing-library/preact": "npm:@testing-library/preact@3.2.4",
    "@types/babel__core": "npm:@types/babel__core@7.20.5",
    "fresh": "jsr:@fresh/core@2.3.3",
    "jsdom": "npm:jsdom@30.0.1",
    "preact": "npm:preact@10.29.8",
    "vite": "npm:vite@7.3.6"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["vite/client"]
  }
}
