{
  "version": "0.61.0",
  "description": "Homoiconic C command-line interface and REPL",
  "entry": "./hc.ts",
  "bin": {
    "hc": "./hc.ts"
  },
  "tasks": {
    "build": "cd .. && deno compile --allow-read --allow-write --allow-env --deny-run --deny-ffi --node-modules-dir=none --output scripts/hc cli/hc.ts",
    "hc": "deno task --config ../deno.json bundle:embed && deno run --allow-read --allow-write --allow-env --deny-run --deny-ffi ./hc.ts",
    "test": "deno test --allow-env --allow-read --allow-write --allow-run --ignore=rest-loopback.test.ts",
    "test:bs": "deno task hc ../hc/BitScheme.hc -t",
    "test:classes": "deno task hc ../hc/class-support.hc -t",
    "test:doc": "deno run --allow-read --allow-write --allow-env --deny-run --deny-ffi ./test-docs.ts",
    "testdoc:summaries": "deno task --config ../deno.json bundle:embed && deno run --allow-read --allow-write --allow-env --deny-run --deny-ffi ./testdoc-summaries.ts"
  },
  "imports": {
    "@nothing628/chalk": "jsr:@nothing628/chalk@^1.0.1"
  }
}
