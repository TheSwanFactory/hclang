{
  "version": "0.15.1",
  "nodeModulesDir": "manual",
  "bin": {
    "hc": "scripts/hc"
  },
  "tasks": {
    "build": "deno task build:cli && deno task build:npm && deno task build:web",
    "build:cli": "cd cli && deno task build",
    "build:npm": "deno run -A scripts/build-npm.ts",
    "build:web": "cd web && deno task build",
    "build:web:release": "deno run -A scripts/build-hcweb.ts --jsr-version",
    "bump": "deno run -A scripts/bump-version.ts",
    "clean": "rm deno.lock */deno.lock",
    "hc": "deno run --allow-read --allow-write --allow-env --deny-run --deny-ffi cli/hc.ts",
    "publish": "deno task publish:lib && deno task publish:web",
    "publish:lib": "cd lib && deno publish",
    "publish:npm": "npm publish",
    "publish:web": "cd web && deno publish",
    "setup": "deno run -A deno-hooks",
    "test": "deno fmt && deno lint --fix && deno task test:all",
    "test:cli": "cd cli && deno task test",
    "test:doc": "cd cli && deno task test:doc",
    "test:lib": "deno test lib",
    "test:maml": "deno test maml",
    "test:npm": "deno task build:npm && deno run -A scripts/test-npm.ts",
    "test:scripts": "deno test scripts",
    "test:web": "cd web && deno task test",
    "test:bs": "cd cli && deno task test:bs",
    "test:all": "deno task test:cli && deno task test:lib && deno task test:scripts && deno task test:web && deno task test:doc && deno task test:bs && deno task test:npm",
    "vscode:package": "cd vscode-extension && npx --yes @vscode/vsce@3.9.2 package",
    "vscode:publish": "cd vscode-extension && npx --yes @vscode/vsce@3.9.2 publish",
    "vscode:install": "cd vscode-extension && npx --yes @vscode/vsce@3.9.2 package && code --install-extension *.vsix"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "deno.ns"
    ]
  },
  "fmt": {
    "exclude": [
      "**/*.html",
      "web/dist/",
      "**/_fresh/",
      "doc/out/",
      "doc/no_equal.md",
      "doc/shannon/1-shannon.md",
      "cli/hc/apply-tutorial.md"
    ]
  },
  "exclude": [
    "web/dist/",
    "**/_fresh/"
  ],
  "deploy": {
    "install": "deno install",
    "build": "deno task build:web",
    "runtime": {
      "type": "static",
      "cwd": "./web/dist"
    }
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "require-await",
        "no-explicit-any"
      ]
    }
  },
  "imports": {
    "@theswanfactory/deno-hooks": "jsr:@theswanfactory/deno-hooks@0.2.1-dev.1765778019",
    "deno-hooks": "jsr:@theswanfactory/deno-hooks@0.2.1-dev.1765778019"
  },
  "workspace": [
    "cli",
    "lib",
    "maml",
    "web",
    "web/tests/consumer"
  ]
}
